{
  "name": "WebCraft AI Agent System",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] }
      },
      "name": "Daily trigger — 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300],
      "id": "trigger-daily"
    },
    {
      "parameters": {
        "url": "https://api.sitescout.com/v1/businesses",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "has_website", "value": "false" },
            { "name": "limit", "value": "270" },
            { "name": "status", "value": "active" }
          ]
        }
      },
      "name": "SiteScout — fetch leads",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 300],
      "id": "sitescout-fetch"
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json);\nconst seen = $getWorkflowStaticData('global').seen_leads || [];\nconst fresh = leads.filter(l => !seen.includes(l.email));\nreturn fresh.slice(0, 270).map(l => ({ json: l }));"
      },
      "name": "Deduplicate leads",
      "type": "n8n-nodes-base.code",
      "position": [680, 300],
      "id": "dedup"
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 300,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Write a 3-sentence cold email to {{ $json.business_name }}, a {{ $json.category }} in {{ $json.city }}. They have no website. Mention a benefit specific to their industry. Soft CTA to see a free mockup. Sign off as WebCraft Team. Return only email body.\"\n  }]\n}"
      },
      "name": "Claude — write cold email",
      "type": "n8n-nodes-base.httpRequest",
      "position": [900, 300],
      "id": "claude-write-email"
    },
    {
      "parameters": {
        "url": "https://api.instantly.ai/api/v1/lead/add",
        "method": "POST",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $env.INSTANTLY_API_KEY }}\",\n  \"campaign_id\": \"{{ $env.INSTANTLY_CAMPAIGN_ID }}\",\n  \"skip_if_in_workspace\": true,\n  \"leads\": [{\n    \"email\": \"{{ $('Deduplicate leads').item.json.email }}\",\n    \"first_name\": \"{{ $('Deduplicate leads').item.json.owner_first_name }}\",\n    \"company_name\": \"{{ $('Deduplicate leads').item.json.business_name }}\",\n    \"custom_variables\": {\n      \"personalized_email\": \"{{ $json.content[0].text }}\"\n    }\n  }]\n}"
      },
      "name": "Instantly — add lead to campaign",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1120, 300],
      "id": "instantly-add"
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "name": "Every 30 min — check replies",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 600],
      "id": "trigger-replies"
    },
    {
      "parameters": {
        "url": "https://api.instantly.ai/api/v1/emails/list",
        "method": "POST",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $env.INSTANTLY_API_KEY }}\",\n  \"campaign_id\": \"{{ $env.INSTANTLY_CAMPAIGN_ID }}\",\n  \"type\": \"reply\",\n  \"limit\": 50\n}"
      },
      "name": "Instantly — fetch replies",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 600],
      "id": "instantly-replies"
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 20,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Classify this reply as exactly one of: INTERESTED, NOT_INTERESTED, OUT_OF_OFFICE, QUESTION, ALREADY_HAS_WEBSITE.\\n\\nReply: \\\"{{ $json.body }}\\\"\"\n  }]\n}"
      },
      "name": "Claude — classify reply",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 600],
      "id": "claude-classify"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.content[0].text.trim() }}",
              "operation": "equals",
              "value2": "INTERESTED"
            }
          ]
        }
      },
      "name": "Is interested?",
      "type": "n8n-nodes-base.if",
      "position": [900, 600],
      "id": "if-interested"
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 300,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Write a reply to {{ $('Instantly — fetch replies').item.json.lead_first_name }} of {{ $('Instantly — fetch replies').item.json.company_name }} who is interested in a website. Tell them you built a free mockup at https://preview.yoursite.com/demo/{{ $('Instantly — fetch replies').item.json.company_name | lower | replace(' ', '-') }} and invite them to book a call at {{ $env.CALENDLY_LINK }}. Under 5 sentences. Sign off as WebCraft. Return only email body.\"\n  }]\n}"
      },
      "name": "Claude — write demo email",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1120, 500],
      "id": "claude-demo-email"
    },
    {
      "parameters": {
        "url": "https://api.instantly.ai/api/v1/emails/reply",
        "method": "POST",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $env.INSTANTLY_API_KEY }}\",\n  \"thread_id\": \"{{ $('Instantly — fetch replies').item.json.thread_id }}\",\n  \"to\": \"{{ $('Instantly — fetch replies').item.json.from_email }}\",\n  \"body\": \"{{ $json.content[0].text }}\"\n}"
      },
      "name": "Instantly — send demo reply",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1340, 500],
      "id": "instantly-reply"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calendly-webhook",
        "responseMode": "onReceived"
      },
      "name": "Calendly webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 900],
      "id": "calendly-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst invitee = body?.payload?.invitee || {};\nconst event = body?.payload?.scheduled_event || {};\nreturn [{\n  json: {\n    name: invitee.name,\n    email: invitee.email,\n    start_time: event.start_time,\n    end_time: event.end_time\n  }\n}];"
      },
      "name": "Extract booking details",
      "type": "n8n-nodes-base.code",
      "position": [460, 900],
      "id": "extract-booking"
    },
    {
      "parameters": {
        "calendar": { "mode": "id", "value": "primary" },
        "start": "={{ $json.start_time }}",
        "end": "={{ $json.end_time }}",
        "additionalFields": {
          "summary": "=Sales call — {{ $json.name }}",
          "description": "=Website sales call with {{ $json.name }} ({{ $json.email }})\n\nBooked via AI agent.",
          "attendees": "={{ $json.email }}",
          "sendUpdates": "all",
          "reminders": {
            "useDefault": false,
            "overrides": [
              { "method": "email", "minutes": 60 },
              { "method": "popup", "minutes": 15 }
            ]
          }
        }
      },
      "name": "Google Calendar — create event",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [680, 900],
      "id": "gcal-create"
    }
  ],
  "connections": {
    "Daily trigger — 8am": { "main": [[{ "node": "SiteScout — fetch leads", "type": "main", "index": 0 }]] },
    "SiteScout — fetch leads": { "main": [[{ "node": "Deduplicate leads", "type": "main", "index": 0 }]] },
    "Deduplicate leads": { "main": [[{ "node": "Claude — write cold email", "type": "main", "index": 0 }]] },
    "Claude — write cold email": { "main": [[{ "node": "Instantly — add lead to campaign", "type": "main", "index": 0 }]] },
    "Every 30 min — check replies": { "main": [[{ "node": "Instantly — fetch replies", "type": "main", "index": 0 }]] },
    "Instantly — fetch replies": { "main": [[{ "node": "Claude — classify reply", "type": "main", "index": 0 }]] },
    "Claude — classify reply": { "main": [[{ "node": "Is interested?", "type": "main", "index": 0 }]] },
    "Is interested?": {
      "main": [
        [{ "node": "Claude — write demo email", "type": "main", "index": 0 }],
        []
      ]
    },
    "Claude — write demo email": { "main": [[{ "node": "Instantly — send demo reply", "type": "main", "index": 0 }]] },
    "Calendly webhook": { "main": [[{ "node": "Extract booking details", "type": "main", "index": 0 }]] },
    "Extract booking details": { "main": [[{ "node": "Google Calendar — create event", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
